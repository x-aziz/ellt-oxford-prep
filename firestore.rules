rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Each signed-in user can read/write ONLY their own data.
    match /users/{uid} {
      // A user can read/update their own profile, but can never set their
      // own role   only an existing admin (editing via the console, or a
      // future admin-only Cloud Function) can grant the admin role.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student');
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;

      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Admin-managed content (mocks & drills): every signed-in student can
    // read it; only an admin can create, edit or delete it.
    match /mocks/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /drills/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Everything else stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
